{
  "name": "dsh-lamp-bridge",
  "version": "0.1.0",
  "description": "Serves DSH session state over HTTP + SSE for the DSH Status Lamp desktop widget, driven by live session events rather than polling files.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "status",
    "lamp"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
