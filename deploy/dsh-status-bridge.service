# 可选：把状态桥做成开机自启的 systemd 服务
#
#   sudo cp deploy/dsh-status-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dsh-status-bridge
#
# 只读服务，仅暴露状态元数据。

[Unit]
Description=DSH status bridge (read-only status over HTTP)
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/claw/PJKT/dsh-status-lamp
Environment=DSH_HOME=/root/.dsh
ExecStart=/usr/bin/python3 -u bridge/state_bridge.py --host 0.0.0.0 --port 3099 --done-seconds 300
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
